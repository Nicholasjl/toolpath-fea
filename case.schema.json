{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PathFEA Agent case v1.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "region": {
      "oneOf": [
        {
          "enum": [
            "X-",
            "X+",
            "Y-",
            "Y+",
            "Z-",
            "Z+"
          ]
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/vector"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boxes"
          ],
          "properties": {
            "boxes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/vector"
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "refinement_strategy": {"type":"string", "enum":["independent","uniform"], "default":"independent"},
    "tetwild_quality_policy": {"type":"string", "enum":["target","measured"], "default":"target"},
    "tetwild_stop_energy": {"type":["number","null"], "minimum":10, "maximum":100, "default":null},
    "tetwild_max_iterations": {"type":"integer", "minimum":1, "maximum":200, "default":80},
    "max_elements": {"type":"integer", "minimum":1, "maximum":5000000, "default":600000},
    "tetgen_radius_edge": {"type":"number", "minimum":1.2, "maximum":3, "default":1.4},
    "tetwild_mode": {
      "enum": ["modern", "legacy", "fast"],
      "default": "modern"
    },
    "mesh_cache_dir": {
      "type": "string",
      "default": "",
      "description": "Optional local content-addressed volume mesh cache; relative to case file."
    },
    "mesh_mode": {
      "enum": [
        "voxel",
        "tetra"
      ],
      "default": "tetra",
      "description": "STL default: quality tetrahedra with boundary refinement (TetGen pq1.4Q); voxel remains explicit opt-in."
    },
    "snap_tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.01,
      "default": 0.0001
    },
    "solver": {
      "enum": [
        "auto",
        "direct",
        "amg"
      ],
      "default": "auto"
    },
    "rtol": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.0001,
      "default": 1e-09
    },
    "maxiter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 2000
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 128,
      "maximum": 16384,
      "default": 4096
    },
    "stl": {
      "type": "string",
      "default": ""
    },
    "gcode": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "default": [
        40,
        12,
        8
      ]
    },
    "pitch": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 2,
      "description": "Initial mesh scale in mm, not an accuracy guarantee. Tetra target volume is pitch^3/6; verify actual volume sizes and two-level refinement."
    },
    "offset": {
      "$ref": "#/$defs/vector",
      "default": [
        0,
        0,
        0
      ]
    },
    "force": {
      "$ref": "#/$defs/vector",
      "default": [
        0,
        0,
        -10
      ]
    },
    "load_point": {
      "$ref": "#/$defs/vector",
      "description": "World-space force application point in mm; distributed equivalent force and moment on loaded surface."
    },
    "angle": {
      "type": "number",
      "default": 0
    },
    "build_axis": {
      "enum": [
        "X",
        "Y",
        "Z"
      ],
      "default": "Z"
    },
    "fixed": {
      "$ref": "#/$defs/region",
      "default": "X-"
    },
    "loaded": {
      "$ref": "#/$defs/region",
      "default": "X+"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "e1": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "e2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "e3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g12": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g23": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g13": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nu12": {
          "type": "number"
        },
        "nu23": {
          "type": "number"
        },
        "nu13": {
          "type": "number"
        }
      }
    },
    "surface_remesh_mm": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "Opt-in analysis surface conditioning target edge in mm; fixed 0.015 mm sampled deviation limit; 0 disables."
    },
    "tetra_backend": {
      "enum": [
        "tetgen",
        "tetwild"
      ],
      "default": "tetgen",
      "description": "Explicit TetWild opt-in requires requirements-robust.txt; never silently switches mesher."
    },
    "surface_tolerance_mm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.015,
      "default": 0.005,
      "description": "TetWild surface envelope in mm; independent topology, volume and distance audits remain mandatory."
    }
  }
}
