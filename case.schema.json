{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PathFEA Agent case v1.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "region": {
      "oneOf": [
        {
          "enum": [
            "X-",
            "X+",
            "Y-",
            "Y+",
            "Z-",
            "Z+"
          ]
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/vector"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boxes"
          ],
          "properties": {
            "boxes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/vector"
                }
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "refinement_strategy": {"type":"string", "enum":["independent","uniform"], "default":"independent"},
    "tetwild_quality_policy": {"type":"string", "enum":["target","measured"], "default":"target"},
    "tetwild_stop_energy": {"type":["number","null"], "minimum":10, "maximum":100, "default":null},
    "tetwild_max_iterations": {"type":"integer", "minimum":1, "maximum":200, "default":80},
    "max_elements": {"type":"integer", "minimum":1, "maximum":5000000, "default":600000},
    "tetgen_radius_edge": {"type":"number", "minimum":1.2, "maximum":3, "default":1.4},
    "tetwild_mode": {
      "enum": ["modern", "legacy", "fast"],
      "default": "modern"
    },
    "mesh_cache_dir": {
      "type": "string",
      "default": "",
      "description": "Optional local content-addressed volume mesh cache; relative to case file."
    },
    "mesh_mode": {
      "enum": [
        "voxel",
        "tetra"
      ],
      "default": "tetra",
      "description": "STL default: quality tetrahedra with boundary refinement (TetGen pq1.4Q); voxel remains explicit opt-in."
    },
    "snap_tolerance": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.01,
      "default": 0.0001
    },
    "solver": {
      "enum": [
        "auto",
        "direct",
        "amg"
      ],
      "default": "auto"
    },
    "rtol": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.0001,
      "default": 1e-09
    },
    "maxiter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 2000
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 128,
      "maximum": 16384,
      "default": 4096
    },
    "stl": {
      "type": "string",
      "default": ""
    },
    "gcode": {
      "type": "string",
      "default": ""
    },
    "size": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "default": [
        40,
        12,
        8
      ]
    },
    "pitch": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 2,
      "description": "Initial mesh scale in mm, not an accuracy guarantee. Tetra target volume is pitch^3/6; verify actual volume sizes and two-level refinement."
    },
    "offset": {
      "$ref": "#/$defs/vector",
      "default": [
        0,
        0,
        0
      ]
    },
    "force": {
      "$ref": "#/$defs/vector",
      "default": [
        0,
        0,
        -10
      ]
    },
    "load_point": {
      "$ref": "#/$defs/vector",
      "description": "World-space force application point in mm; distributed equivalent force and moment on loaded surface."
    },
    "angle": {
      "type": "number",
      "default": 0
    },
    "build_axis": {
      "enum": [
        "X",
        "Y",
        "Z"
      ],
      "default": "Z"
    },
    "fixed": {
      "$ref": "#/$defs/region",
      "default": "X-"
    },
    "loaded": {
      "$ref": "#/$defs/region",
      "default": "X+"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "e1": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "e2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "e3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g12": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g23": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "g13": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nu12": {
          "type": "number"
        },
        "nu23": {
          "type": "number"
        },
        "nu13": {
          "type": "number"
        }
      }
    },
    "surface_remesh_mm": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "Opt-in analysis surface conditioning target edge in mm; fixed 0.015 mm sampled deviation limit; 0 disables."
    },
    "tetra_backend": {
      "enum": [
        "tetgen",
        "tetwild"
      ],
      "default": "tetgen",
      "description": "Explicit TetWild opt-in requires requirements-robust.txt; never silently switches mesher."
    },
    "surface_tolerance_mm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.015,
      "default": 0.005,
      "description": "TetWild surface envelope in mm; independent topology, volume and distance audits remain mandatory."
    },
    "engine": {
      "type": "string",
      "enum": ["auto", "toolpath_graph", "toolpath_hex", "legacy_solid"],
      "default": "auto",
      "description": "Solver engine selector: auto uses toolpath_graph when gcode is provided (no --angles), else legacy_solid."
    },
    "device": {
      "type": "string",
      "enum": ["auto", "cuda:0", "cpu"],
      "default": "auto",
      "description": "Warp compute backend for toolpath_graph and toolpath_hex."
    },
    "toolpath_pitch_mm": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 2.0,
      "default": 0.2,
      "description": "XY voxel pitch in mm for engine='toolpath_hex'."
    },
    "toolpath_dz_mm": {
      "type": ["number", "null"],
      "minimum": 0.05,
      "maximum": 2.0,
      "default": null,
      "description": "Optional Z voxel pitch in mm for engine='toolpath_hex'; null uses toolpath_pitch_mm."
    },
    "toolpath_max_seg_len_mm": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5.0,
      "default": 1.0,
      "description": "Max arc-length segment spacing in mm for engine='toolpath_graph'."
    },
    "toolpath_cache_path": {
      "type": "string",
      "default": "",
      "description": "Optional .tgraph or .tbricks model cache path relative to case file."
    },
    "spill_stress": {
      "type": "boolean",
      "default": false,
      "description": "Stream element stress binaries (graph_stress.bin / stress_fields.bin) into the run artifact directory."
    },
    "keep_largest_component": {
      "type": "boolean",
      "default": true,
      "description": "Prune disconnected islands when building toolpath graph or brick grid."
    },
    "seam_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ideal": {"type": "boolean"},
        "seam_stiffness_factor": {"type": "number", "exclusiveMinimum": 0},
        "scarf_seam_stiffness_factor": {"type": "number", "exclusiveMinimum": 0},
        "start_anchor_factor": {"type": "number", "exclusiveMinimum": 0},
        "stop_anchor_factor": {"type": "number", "exclusiveMinimum": 0},
        "start_zone_beam_factor": {"type": "number", "exclusiveMinimum": 0},
        "stop_zone_beam_factor": {"type": "number", "exclusiveMinimum": 0},
        "lateral_weld_factor": {"type": "number", "exclusiveMinimum": 0},
        "interlayer_weld_factor": {"type": "number", "exclusiveMinimum": 0},
        "thermal_decay_tau_s": {"type": "number", "minimum": 0},
        "thermal_min_factor": {"type": "number", "exclusiveMinimum": 0},
        "beam_calibration_factor": {"type": "number", "exclusiveMinimum": 0},
        "bond_calibration_factor": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "strength_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sigma_beam_allow_MPa": {"type": "number", "exclusiveMinimum": 0},
        "sigma_interlayer_allow_MPa": {"type": "number", "exclusiveMinimum": 0},
        "tau_interlayer_allow_MPa": {"type": "number", "exclusiveMinimum": 0},
        "sigma_lateral_allow_MPa": {"type": "number", "exclusiveMinimum": 0},
        "tau_lateral_allow_MPa": {"type": "number", "exclusiveMinimum": 0},
        "strength_scale_exponent": {"type": "number", "minimum": 0, "maximum": 3}
      }
    },
    "hex_interface_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weakened": {"type": "boolean"},
        "seam_factor": {"type": "number", "exclusiveMinimum": 0},
        "start_stop_factor": {"type": "number", "exclusiveMinimum": 0},
        "bead_interface_factor": {"type": "number", "exclusiveMinimum": 0},
        "interlayer_shear_factor": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
